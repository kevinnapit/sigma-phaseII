{
	"name": "sigma-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run build:sw && vite build",
		"build:sw": "bun build src/generate-sw.ts --outfile static/generate-sw.js --target browser",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"generate:schema": "bun run --bun scripts/gen-zod-schema.ts",
		"generate:pwa": "bun --bun run pwa-assets-generator",
		"preview:bun": "bun run server.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "^4.1.17",
		"@tanstack/svelte-query-devtools": "^6.0.4",
		"@tanstack/svelte-query-persist-client": "^6.0.20",
		"@types/bun": "^1.3.5",
		"@types/node": "^22",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.0.15",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"formsnap": "^2.0.1",
		"globals": "^16.5.0",
		"json-refs": "^3.0.15",
		"json-schema-to-zod": "^2.7.0",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"sveltekit-superforms": "^2.28.1",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@tanstack/svelte-form": "^1.27.7",
		"@tanstack/svelte-query": "^6.0.15",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"html5-qrcode": "^2.3.8",
		"idb-keyval": "^6.2.2",
		"jspdf": "^4.2.0",
		"lucide-svelte": "^0.562.0",
		"openapi-fetch": "^0.15.0",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.3.5"
	}
}
